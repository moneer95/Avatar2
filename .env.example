# --- Web app (Vite) — connects as a viewer to the TTS output socket ---
VITE_WS_URL=ws://localhost:3002/api/tts-output-ws
# Must match TTS_OUTPUT_SECRET below (same as AudiofishTTS .env)
VITE_WS_SECRET=devsecret

# Avatar asset paths (optional overrides)
# VITE_AVATAR_URL=/models/Monir.glb
# VITE_ANIM_IDLE=/animations/Standing%20W_Briefcase%20Idle.fbx
# VITE_ANIM_WAVE=/animations/Standing%20Arguing.fbx
# VITE_ANIM_TALK=/animations/Talking.fbx

# --- TTS output server (Node, port 3002) ---
PORT=3002
TTS_OUTPUT_SECRET=YOUR_OUTPUT_SECRET

# AudiofishTTS .env (separate app) should include:
#   FORWARD_DEST_URL=localhost:3002
#   TTS_OUTPUT_SECRET=devsecret   (same value as above)
